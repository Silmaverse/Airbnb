<%- layout("/layouts/boilerplate") %>
<script>
     let mapToken="<%=process.env.MAP_TOKEN%>"
     const coordinates =<%-JSON.stringify(listing.geometry.coordinates) %>;
     let locate= <%- JSON.stringify(listing.location) %>
  </script>
<body>
  <div class="row">
    <div class="col-8 offset-2">
      <h3 class="py-3">Listing Details:</h3>
    </div>
    <div class="card col-8 show-card offset-2 my-2">
      <img src="<%= listing.image.url%>" class="card-img-top" alt="..." />
      <div class="card-body">
        <h5 class="card-title py-1"><%= listing.title %></h5>
        <p><%=listing.description %></p>
        <p><b><%= listing.category %></b></p>
        <p class="card-text py-1">
          &#2547;<%= listing.price.toLocaleString("en-Bd") %>
        </p>
        <p class="py-1"><%= listing.location %></p>
        <p class="py-1"><%= listing.country %></p>
        <p class="brandColor">Host : <i><%= listing.owner?.username|| "Airbnb host" %></i></p>
        <div class="row my-2">
          <h5 class="py-2">All Reviews</h5>
          <% for(review of listing.reviews) {%>
            <div class="card col-5 ms-2 mb-2">
              <div class="card-body">
                <h5 class="card-title"><%= review.author.username %></h5>
                <p><%= review.rating %> stars</p>
                  <p class="starability-result my-2" data-rating="<%= review.rating %>">
    Rated: 3 stars
  </p>
                <p><%= review.comment %></p>
                <form method="post" class="my-2" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                  <button class="btn btn-sm btn-dark">Delete</button>
                </form>
              </div>
            </div>
            <% } %>
          </div>
          <div class="col-8 ">
            <h3 class="my-3">Where you’ll be</h3>
            <div id="map"></div>

           </div>
           <% if(currUser && currUser._id.equals(listing.owner._id)) { %> 
        <div class="d-flex gap-3 py-2">
          <a 
            href="/listings/<%= listing._id %>/edit"
            class="btn btn-custom w-25"
            >Edit </a
          >
          <form class="w-25"
            method="post"
            action="/listings/<%=listing._id %>?_method=DELETE"
          >
            <button class="btn btn-dark w-100">Delete It</button>
          </form>
        </div>
         <% } %>
      </div>
    </div>
    <hr>
    <div class="col-8 offset-2">
      <% if(currUser){ %>
      <h4>Leave a Review</h4>
      <form method="post" action="/listings/<%= listing.id %>/reviews" novalidate  class="my-2 needs-validation">
        <fieldset class="starability-slot my-2">
  
  <!-- Reset option (important!) -->
  <input type="radio" id="no-rate" class="input-no-rate"
         name="review[rating]" value="0" checked aria-label="No rating." />

  <input type="radio" id="first-rate1" name="review[rating]" value="1" required />
  <label for="first-rate1" title="Terrible">1 star</label>

  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>

  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>

  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>

  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Excellent">5 stars</label>

</fieldset>
        <div class="my-2">
          <label for="comment" class="my-2 form-label">Comments</label>
          <textarea name="review[comment]" id="comment" cols="20" rows="5" class="form-control" required></textarea>
        </div>
        <button type="submit" class="btn btn-dark my-2">Submit</button>
      </form>
      <% } %>
    </div>

  </div>
  <script src="/js/map.js">

  </script>
</body>
