<%- layout("/layouts/boilerplate") %>
<body>
  <div class="row">
    <div class="col-8 offset-2">
      <h3 class="py-3">Listing Details:</h3>
    </div>
    <div class="card col-8 show-card offset-2">
      <img src="<%= listing.image.url %>" class="card-img-top" alt="..." />
      <div class="card-body">
        <h5 class="card-title py-1"><%= listing.title %></h5>
        <p><%=listing.description %></p>
        <p class="card-text py-1">
          &#2547;<%= listing.price.toLocaleString("en-Bd") %>
        </p>
        <p class="py-1"><%= listing.location %></p>
        <p class="py-1"><%= listing.country %></p>
        <div class="d-flex gap-3 py-2">
          <a 
            href="/listings/<%= listing._id %>/edit"
            class="btn btn-custom w-25"
            >Edit </a
          >
          <form class="w-25"
            method="post"
            action="/listings/<%=listing._id %>?_method=DELETE"
          >
            <button class="btn btn-dark w-100">Delete It</button>
          </form>
        </div>
      </div>
    </div>
    <hr>
    <div class="col-8 offset-2">
      <h4>Leave a Review</h4>
      <form method="post" action="/listings/<%= listing.id %>/reviews"  class="my-2">
        <div class="my-3">
          <label for="rating" class="form-label">Rating</label>
          <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range"/>
        </div>
        <div class="my-2">
          <label for="comment" class="my-2 form-label">Comments</label>
          <textarea name="review[comment]" id="comment" cols="20" rows="5" class="form-control"></textarea>
        </div>
        <button type="submit" class="btn btn-dark my-2">Submit</button>
      </form>
    </div>

  </div>
</body>
