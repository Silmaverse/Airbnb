<%- layout("/layouts/boilerplate") %>
<body>
  <div class="row">
    <div class="col-8 offset-2">
      <h3 class="py-3">Listing Details:</h3>
    </div>
    <div class="card col-8 show-card offset-2">
      <img src="<%= listing.image.url?listing.image.url:listing.image %>" class="card-img-top" alt="..." />
      <div class="card-body">
        <h5 class="card-title py-1"><%= listing.title %></h5>
        <p><%=listing.description %></p>
        <p class="card-text py-1">
          &#2547;<%= listing.price.toLocaleString("en-Bd") %>
        </p>
        <p class="py-1"><%= listing.location %></p>
        <p class="py-1"><%= listing.country %></p>
        <p class="brandColor">Host : <i><%= listing.owner.username %></i></p>
        <h5 class="py-2">All Reviews</h5>
        <div class="row">
          <% for(review of listing.reviews) {%>
            <div class="card col-5 ms-2 mb-2">
              <div class="card-body">
                <h5 class="card-title"><%= review.author.username %></h5>
                <p><%= review.rating %> stars</p>
                <p><%= review.comment %></p>
                <form method="post" class="my-2" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                  <button class="btn btn-sm btn-dark">Delete</button>
                </form>
              </div>
            </div>
            <% } %>
          </div>
           <% if(currUser && currUser._id.equals(listing.owner._id)) { %> 
        <div class="d-flex gap-3 py-2">
          <a 
            href="/listings/<%= listing._id %>/edit"
            class="btn btn-custom w-25"
            >Edit </a
          >
          <form class="w-25"
            method="post"
            action="/listings/<%=listing._id %>?_method=DELETE"
          >
            <button class="btn btn-dark w-100">Delete It</button>
          </form>
        </div>
         <% } %>
      </div>
    </div>
    <hr>
    <div class="col-8 offset-2">
      <% if(currUser){ %>
      <h4>Leave a Review</h4>
      <form method="post" action="/listings/<%= listing.id %>/reviews" novalidate  class="my-2 needs-validation">
        <div class="my-3">
          <label for="rating" class="form-label">Rating</label>
          <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range"/>
        </div>
        <div class="my-2">
          <label for="comment" class="my-2 form-label">Comments</label>
          <textarea name="review[comment]" id="comment" cols="20" rows="5" class="form-control" required></textarea>
        </div>
        <button type="submit" class="btn btn-dark my-2">Submit</button>
      </form>
      <% } %>
    </div>

  </div>
</body>
