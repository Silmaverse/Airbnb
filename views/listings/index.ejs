<%- layout("/layouts/boilerplate") %>
<body>
    
    <div class="allFilters d-flex flex-wrap justify-content-between align-items-center my-3">

        <div class="allCategory d-flex flex-wrap gap-4  ">
            <div class="mountain d-flex flex-column align-items-center">
                <i class="fa-solid fa-mountain-city"></i>
                <p>Mountain</p>
            </div>
            <div class="mountain d-flex flex-column align-items-center">
                 <i class="fa-solid fa-tent"></i>
                <p>Tent</p>
            </div>
            <div class="mountain d-flex flex-column align-items-center">
                 <i class="fa-solid fa-fire"></i>
                <p>Summer</p>
            </div>
            <div class="mountain d-flex flex-column align-items-center">
                 <i class="fa-solid fa-cloud-moon"></i>
                <p>Cloudy</p>
            </div>
            <div class="mountain d-flex flex-column align-items-center">
                <i class="fa-regular fa-snowflake"></i>
                <p>Winter</p>
            </div>
            <div class="mountain d-flex flex-column align-items-center">
                <i class="fa-brands fa-canadian-maple-leaf"></i>
                <p>Flower</p>
            </div>
            <div class="mountain d-flex flex-column align-items-center">
                <i class="fa-brands fa-pagelines"></i>
                <p>Tree</p>
            </div>
            <div class="mountain d-flex flex-column align-items-center">
                <i class="fa-solid fa-city"></i>
                <p>City</p>
            </div>
            <div class="mountain d-flex flex-column align-items-center">
                <i class="fa-solid fa-road"></i>
                <p>Street Place</p>
            </div>
             <div class="mountain d-flex flex-column align-items-center">
                <i class="fa-solid fa-igloo"></i>
                <p>Igloo Place</p>
            </div>
            <div class="mountain d-flex flex-column align-items-center">
                <i class="fa-solid fa-sailboat"></i>
                <p>Boat Place</p>
            </div>
        </div>
         <div class="taxswitch">

             <div class="form-check-reverse form-switch ">
                 <label class="form-check-label " for="switchCheckDefault">Default switch checkbox input</label>
                 <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            </div>
        </div>
        
    </div>

    <div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1 gx-4 gy-5">

        <% for(let list of alllistings) { %>
            <div class="col">
                <a href="/listings/<%= list._id %>">

                    <div class="card list-card">
                        <img src="<%=list.image.url? list.image.url:list.image.filename %>" class="card-img-top" alt="listing_image">
                        <div class="card-img-overlay overlay">
                            
                        </div>
                        <div class="card-body">
                            <h6 class="card-title"><p><b><%= list.title %></b></p></h6>
                            <p > <%= list.description %></p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div class="">
                                    <p class="card-text"> &#2547;<%= list.price.toLocaleString("en-BD") %> for 1 night</p>
                                    <i class="d-none displayTax">15% vat included</i>
                                </div>
                                <p><i class="fa-solid fa-star text-secondary"></i> 4.3</p>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    </div>
</body>
