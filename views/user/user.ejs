<%- layout("/layouts/boilerplate.ejs") %>

<div class="row mt-2">
  <h2 class="col-6 offset-3 mt-2">SignUp on wanderlust</h2>
  <div class="col-6 offset-3">
    <form action="/signup" method="post" novalidate class="needs-validation">
      <div class="my-3">
        <label for="username" class="form-label fs-3">Username</label>
        <input
          name="username"
          placeholder="Enter Username"
          id="username"
          type="text"
          required
          class="form-control my-2"
        />
        <div class="invalid-feedback">Please Enter a valid Title.</div>
      </div>
      <div class="my-3">
        <label for="email" class="form-label fs-3">Email</label>
        <input
          name="email"
          placeholder="Enter email"
          id="email"
          type="email"
          required
          class="form-control my-2"
        />
        <div class="invalid-feedback">Please Enter a valid Email.</div>
      </div>
      <div class="my-3">
        <label for="password" class="form-label fs-3">Password</label>
        <input
          name="password"
          placeholder="Enter Password"
          id="password"
          type="password"
          required
          class="form-control my-2"
        />
        <div class="invalid-feedback">Please Enter a valid Password.</div>
      </div>
      <button class="btn btn-success">Sign Up</button>
    </form>
  </div>
</div>
